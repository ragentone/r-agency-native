# Gilt für alle Umgebungen (Expo lädt zusätzlich .env.development / .env.production).

# Google-Login – gleicher OAuth-Client wie die Web-App (VITE_GOOGLE_CLIENT_ID). Öffentlich, kein Geheimnis.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=447389050448-7eekju07pc2poefbsbfmfar3jrjpe4l8.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth

# Android/iOS: Callback-Seite der Web-App (deren index.html springt per r-agency:// zurück in die App).
# EXPO_PUBLIC_GOOGLE_REDIRECT_URI=https://<web-app-domain>/auth/google/callback

# Web (Expo im Browser): Standard ist die eigene Adresse, z. B. http://localhost:8081 –
# muss in der Google Cloud Console als "Autorisierte Weiterleitungs-URI" eingetragen sein.
# EXPO_PUBLIC_GOOGLE_WEB_REDIRECT_URI=http://localhost:8081
